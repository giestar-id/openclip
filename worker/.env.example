# Database SQLite (Single File, Plug & Play, Otomatis relatif ke project root)
DB_PATH=database/clipper.db

# Storage & AI Models (Tersimpan di folder storage project)
STORAGE_DIR=storage
MODELS_DIR=storage/models

# Hugging Face Settings
HF_HOME=storage/models
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Polling interval (detik)
POLL_INTERVAL=2

# Resolusi Klip & Preview (1080 = Full HD 1080p, 720 = HD 720p)
PREVIEW_HEIGHT=720

# Optional API Keys (Bisa diisi di sini atau langsung lewat menu Settings di Web UI)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
