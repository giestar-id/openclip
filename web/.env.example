# ========================================================
# OpenClip Web Frontend - Environment Configuration
# ========================================================

# Jalur Database SQLite (Opsional, bawaan otomatis mengarah ke ../database/clipper.db)
# DB_PATH=../database/clipper.db

# Kunci API Opsional (Dapat juga dikonfigurasi melalui menu Settings di Web UI)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
